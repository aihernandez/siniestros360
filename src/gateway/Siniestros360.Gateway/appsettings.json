{
  "Jwt": {
    "Issuer": "Siniestros360.Identity",
    "Audience": "Siniestros360"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-login": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/api/v1/auth/login"
        }
      },
      "identity": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "reads",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "claims": {
        "ClusterId": "claims",
        "RateLimiterPolicy": "commands",
        "Match": {
          "Path": "/api/v1/claims/{**catch-all}"
        }
      },
      "adjusters": {
        "ClusterId": "adjusters",
        "RateLimiterPolicy": "commands",
        "Match": {
          "Path": "/api/v1/adjusters/{**catch-all}"
        }
      },
      "locations": {
        "ClusterId": "locations",
        "RateLimiterPolicy": "gps",
        "Match": {
          "Path": "/api/v1/locations/{**catch-all}"
        }
      },
      "dispatch": {
        "ClusterId": "dispatch",
        "RateLimiterPolicy": "commands",
        "Match": {
          "Path": "/api/v1/dispatch/{**catch-all}"
        }
      },
      "documents": {
        "ClusterId": "documents",
        "RateLimiterPolicy": "documents",
        "Match": {
          "Path": "/api/v1/documents/{**catch-all}"
        }
      },
      "operations": {
        "ClusterId": "operations",
        "RateLimiterPolicy": "reads",
        "Match": {
          "Path": "/api/v1/operations/{**catch-all}"
        }
      },
      "operations-hub": {
        "ClusterId": "operations",
        "Match": {
          "Path": "/hubs/operations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://identity-service"
          }
        }
      },
      "claims": {
        "Destinations": {
          "primary": {
            "Address": "http://claims-service"
          }
        }
      },
      "adjusters": {
        "Destinations": {
          "primary": {
            "Address": "http://adjusters-service"
          }
        }
      },
      "locations": {
        "Destinations": {
          "primary": {
            "Address": "http://location-service"
          }
        }
      },
      "dispatch": {
        "Destinations": {
          "primary": {
            "Address": "http://dispatch-service"
          }
        }
      },
      "documents": {
        "Destinations": {
          "primary": {
            "Address": "http://documents-service"
          }
        }
      },
      "operations": {
        "Destinations": {
          "primary": {
            "Address": "http://operations-service"
          }
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost",
      "https://localhost",
      "capacitor://localhost"
    ]
  },
  "RateLimits": {
    "LoginPerMinute": 10,
    "GpsPerMinute": 300,
    "CommandsPerMinute": 60,
    "DocumentsPerMinute": 20,
    "ReadsPerMinute": 600
  }
}
