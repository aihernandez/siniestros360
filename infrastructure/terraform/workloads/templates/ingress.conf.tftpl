map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
map $host $frontend {
  insured.${base_domain} insured-app.${namespace}.svc.cluster.local:8080;
  adjuster.${base_domain} adjuster-app.${namespace}.svc.cluster.local:8080;
  tower.${base_domain} control-tower.${namespace}.svc.cluster.local:8080;
  default gateway.${namespace}.svc.cluster.local:80;
}
server {
  listen 8080;
  resolver ${dns_ip} valid=10s;
  client_max_body_size 16m;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  location = /health { proxy_pass http://gateway:80/health; }
  location /api/ { proxy_pass http://gateway:80; }
  location /hubs/ {
    proxy_pass http://gateway:80;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 3600s;
  }
  location / { proxy_pass http://$frontend; }
}
